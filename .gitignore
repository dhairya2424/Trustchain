# Local development runtime artifacts. Generated by the local pinner and the seed script,
# never committed: they are machine-specific, and the seed record contains DID and role
# hashes that trip the secret scanner as 32-byte hex.
.local-ipfs/
packages/contracts/deployments/*.seed.json

# OpenZeppelin Relayer local secrets and signer keystore. The passphrase in .env decrypts
# the keystore, so neither may ever be committed; config.json holds placeholders only.
infra/relayer/.env
infra/relayer/config/keys/
infra/relayer/config/config.json
.relayer-build/

# Playwright
test-results/
playwright-report/
blob-report/

# Screenshots from tools/drive-app.mjs — build output, regenerated on every run.
.screenshots/
