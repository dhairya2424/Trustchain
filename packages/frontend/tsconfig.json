{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    // No "baseUrl": it is deprecated in TypeScript 6, and unnecessary — "paths" now
    // resolves relative to this file's directory, which is what we wanted anyway.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
