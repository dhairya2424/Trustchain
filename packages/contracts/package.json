{
  "name": "@trustchain/contracts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:foundry": "forge test --fuzz-runs 1000",
    "coverage": "hardhat clean && hardhat coverage",
    "coverage:check": "npm run coverage && node tools/check-coverage.mjs",
    "slither": "hardhat clean && hardhat compile && slither . --fail-medium",
    "gas:report": "node tools/gas-report.mjs",
    "node": "hardhat node",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint-solidity.mjs",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "verify:amoy": "hardhat run scripts/verify.ts --network amoy",
    "ownership:amoy": "hardhat run scripts/verifyOwnership.ts --network amoy",
    "transfer-admin:amoy": "hardhat run scripts/transferAdminToSafe.ts --network amoy",
    "defender:render:amoy": "hardhat run scripts/defenderRegister.ts --network amoy",
    "seed": "hardhat run scripts/seed.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "hardhat": "^2.22.17",
    "solhint": "^5.0.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0"
  }
}
