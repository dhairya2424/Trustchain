{
  "name": "sih-26",
  "version": "1.0.0",
  "private": true,
  "description": "TrustChain — decentralized identity, on-chain RBAC and NFT-based asset ownership",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "turbo run build",
    "chain": "npm run node --workspace @trustchain/contracts",
    "coverage": "npm run coverage --workspace @trustchain/contracts",
    "deploy:amoy": "npm run deploy:amoy --workspace @trustchain/contracts",
    "deploy:local": "npm run deploy:local --workspace @trustchain/contracts",
    "deployer:key": "node tools/gen-deployer-key.mjs",
    "dev": "turbo run dev --parallel",
    "dev:env": "node tools/gen-dev-env.mjs",
    "diagrams": "npx -y @mermaid-js/mermaid-cli@11 -i docs/ARCHITECTURE.mmd -o docs/ARCHITECTURE.png -w 2400 -s 2 -b white && npx -y @mermaid-js/mermaid-cli@11 -i docs/WORKFLOW.mmd -o docs/WORKFLOW.png -w 2400 -s 2 -b white",
    "e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,sol,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,sol,yml,yaml}\"",
    "lint": "turbo run lint",
    "relayer:address": "node tools/relayer-address.mjs",
    "relayer:config": "node tools/gen-relayer-config.mjs",
    "relayer:key": "docker run --rm --env-file infra/relayer/.env -v \"$PWD/infra/relayer:/out\" rust:1-slim bash /out/create-key.sh",
    "relayer:secrets": "node tools/gen-relayer-secrets.mjs",
    "relayer:status": "node tools/relayer-status.mjs",
    "relayer:up": "docker compose up -d redis relayer",
    "security:all": "npm run security:secrets && npm run security:history && npm run security:sql && npm run security:xss && npm run security:responses && npm run security:deps && npm run security:bundle && npm run test:tools",
    "security:audit": "node tools/run-audit.mjs",
    "security:history": "node tools/scan-history.mjs",
    "security:responses": "npm run test --workspace @trustchain/backend -- run src/http/responseValidation.test.ts",
    "security:bundle": "npm run build --workspace @trustchain/frontend && node tools/check-frontend-bundle.mjs",
    "security:deps": "npm run security:lockfile && npm run security:audit",
    "security:lockfile": "node tools/check-lockfile.mjs",
    "security:secrets": "node tools/scan-secrets.mjs",
    "security:sql": "node tools/check-sql.mjs packages/backend/src",
    "security:xss": "node tools/check-xss.mjs packages/frontend/src packages/backend/src",
    "seed": "npm run seed --workspace @trustchain/contracts",
    "seed:amoy": "npm run seed:amoy --workspace @trustchain/contracts",
    "test": "turbo run test",
    "test:tools": "vitest run",
    "typecheck": "turbo run typecheck",
    "e2e:install": "playwright install --with-deps chromium",
    "design:check": "node tools/apply-type-scale.mjs --check"
  },
  "comments": {
    "overrides": "Patched transitive dependencies pulled in by the Hardhat 2 toolchain. npm's own fix for each of these is a major upgrade to Hardhat 3, which is a config-format rewrite we are not taking mid-build. Each pin below stays inside the dependant's expected major, so the toolchain API is unchanged. Revisit when migrating to Hardhat 3."
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "lodash": "^4.18.1",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.1.1",
    "tmp": "^0.2.7",
    "undici": "^6.28.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.9",
    "prettier-plugin-solidity": "^1.4.2",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  }
}
