# =============================================================================
# TrustChain — canonical list of every environment variable in the system.
#
# This file is documentation. Copy each section into the matching package file:
#
#   packages/backend/.env     server-only. NEVER reaches a browser.
#   packages/frontend/.env    VITE_PUBLIC_* only. Treat as world-readable.
#   packages/contracts/.env   deploy keys. Workstation / CI only.
#   .env                      infrastructure values read by docker-compose.
#
# Rules enforced by tooling:
#   - `npm run security:secrets` fails on real-looking credentials in tracked files.
#   - `npm run security:bundle` fails if a server-only name or value reaches dist/.
#   - The backend refuses to boot when a required variable is missing or malformed.
#
# Every value below is a placeholder. Never commit a real one.
# =============================================================================

# -----------------------------------------------------------------------------
# INFRASTRUCTURE (root .env — consumed by docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=trustchain
POSTGRES_PASSWORD=replace-me-local-dev-only
POSTGRES_DB=trustchain

# -----------------------------------------------------------------------------
# BACKEND (packages/backend/.env) — SERVER-ONLY SECRETS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Datastores
DATABASE_URL=postgresql://trustchain:replace-me-local-dev-only@localhost:5432/trustchain
REDIS_URL=redis://localhost:6379

# Session / auth. RS256 keypair, PEM, newlines escaped as \n.
JWT_PRIVATE_KEY=replace-me-with-rs256-private-key-pem
JWT_PUBLIC_KEY=replace-me-with-rs256-public-key-pem
JWT_ACCESS_TTL_SECONDS=900
SESSION_COOKIE_NAME=trustchain_session
SESSION_COOKIE_DOMAIN=localhost

# Sign-In With Ethereum
SIWE_DOMAIN=localhost:5173
SIWE_ORIGIN=http://localhost:5173
SIWE_NONCE_TTL_SECONDS=300

# Field-level encryption for off-chain PII (32 random bytes, base64).
FIELD_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64

# Chain access
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed contract addresses (public information, but the backend needs them).
ROLE_ACCESS_CONTROL_ADDRESS=0x0000000000000000000000000000000000000000
DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ASSET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CREDENTIAL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
AUDIT_TRAIL_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS pinning (Pinata)
PINATA_JWT=replace-me-with-pinata-jwt
PINATA_GATEWAY=https://replace-me.mypinata.cloud

# Bot protection (Cloudflare Turnstile) — secret half
TURNSTILE_SECRET_KEY=replace-me-with-turnstile-secret

# Relayer (OpenZeppelin Defender) — optional until P1.6

# -----------------------------------------------------------------------------
# FRONTEND (packages/frontend/.env) — PUBLIC ONLY
# Anything here ships inside the JavaScript bundle. If a value must stay
# private, it does not belong in this section.
# -----------------------------------------------------------------------------
VITE_PUBLIC_API_URL=http://localhost:4000
VITE_PUBLIC_CHAIN_ID=31337
VITE_PUBLIC_CHAIN_RPC_URL=http://127.0.0.1:8545
# Optional, and worth understanding. Without it the only way to sign in is a browser
# extension, because WalletConnect is what lets someone pair a phone wallet instead.
# A visitor with no extension is told so plainly and pointed at the public verifier, but
# they cannot sign in at all. Free id from https://cloud.reown.com.
VITE_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-me-walletconnect-project-id
VITE_PUBLIC_IPFS_GATEWAY=https://replace-me.mypinata.cloud
VITE_PUBLIC_TURNSTILE_SITE_KEY=replace-me-turnstile-site-key
VITE_PUBLIC_SENTRY_DSN=
VITE_PUBLIC_ROLE_ACCESS_CONTROL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PUBLIC_DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PUBLIC_ASSET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PUBLIC_AUDIT_TRAIL_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# CONTRACTS (packages/contracts/.env) — DEPLOY KEYS
# -----------------------------------------------------------------------------
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/replace-me
DEPLOYER_PRIVATE_KEY=replace-me-with-deployer-private-key
POLYGONSCAN_API_KEY=replace-me-with-polygonscan-key
SAFE_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
REPORT_GAS=false

# Self-hosted OpenZeppelin Relayer (v1.5.x). The signing key lives in that service and is
# declared by infra/relayer/config.json — never in this file and never in the application.
# Swapping the local encrypted keystore for AWS KMS is a change to that config, not here.
RELAYER_URL=http://localhost:8081
RELAYER_ID=trustchain-amoy
RELAYER_API_KEY=replace-me-with-the-relayer-api-key
RELAYER_SPEED=average

# Polygon Amoy RPC endpoint. Carries an API key with most providers, so it lives here only.
POLYGON_AMOY_RPC_URL=https://replace-me-with-your-amoy-endpoint
